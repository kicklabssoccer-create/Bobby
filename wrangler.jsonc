{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kicklab",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "KICKLAB_KV",
      "id": "ff330f2426bb476db92edeba78d3fcb8"
    }
  ],
  "vars": {
    "MAILCHIMP_SERVER": "us16"
  },
  // Custom domain — connect kicklabssoccer.com in Cloudflare Pages dashboard:
  // Pages → kicklab project → Custom domains → Add → kicklabssoccer.com & www.kicklabssoccer.com
  "routes": [
    { "pattern": "kicklabssoccer.com/*", "zone_name": "kicklabssoccer.com" },
    { "pattern": "www.kicklabssoccer.com/*", "zone_name": "kicklabssoccer.com" }
  ]
}
